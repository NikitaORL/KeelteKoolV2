@model KeelteKoolV2.Core.DTO.LecturerDTO

<h1>Lisa uus õppejõud</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="FirstName">Eesnimi</label>
        <input asp-for="FirstName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="LastName">Perekonnanimi</label>
        <input asp-for="LastName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Qualifications">Kvalifikatsioon</label>
        <input asp-for="Qualifications" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Salvesta</button>
</form>