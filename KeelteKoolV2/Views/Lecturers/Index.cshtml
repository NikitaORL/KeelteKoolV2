@model IEnumerable<KeelteKoolV2.Core.DTO.LecturerDTO>

@{
    ViewBag.Title = "Õppejõud";
}

<div class="h1">Õppejõud (Lecturers)</div>

<a asp-action="Create" class="btn btn-dark mb-3">Lisa uus õppejõud</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Eesnimi</th>
            <th>Perekonnanimi</th>
            <th>Kvalifikatsioon</th>
            <th>Tegevused</th> <!-- Новый столбец -->
        </tr>
    </thead>
    <tbody>
        @foreach (var lecturer in Model)
        {
            <tr>
                <td>@lecturer.FirstName</td>
                <td>@lecturer.LastName</td>
                <td>@lecturer.Qualifications</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@lecturer.Id" class="btn btn-warning btn-sm">Muuda</a>
                    <a asp-action="Delete" asp-route-id="@lecturer.Id" class="btn btn-danger btn-sm">Kustuta</a>
                </td>
            </tr>
        }
    </tbody>
</table>